<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ركن البشوات — لوحة المدير</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Cairo',sans-serif}
[hidden]{display:none!important}
body{background:#f7f1e6;color:#2b1a15}
.gate{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#3a1710,#5a241c)}
.gc{background:#f7f1e6;border:2px solid #c9973b;border-radius:22px;padding:1.5rem;width:min(340px,90%);text-align:center}
.gc img{width:76px;height:76px;border-radius:50%;margin:0 auto 8px;border:3px solid #c9973b;object-fit:cover}
.gc h2{color:#4d231b}.gc p{color:#8a6f63;font-size:.75rem;font-weight:700}
.gc input{width:100%;margin:.9rem 0 .5rem;border:1.5px solid #e8dcc9;border-radius:12px;padding:.7rem;text-align:center;font-weight:700;outline:none}
.btn{background:#4d231b;color:#fff;border:none;border-radius:50px;padding:.65rem 1.6rem;font-weight:900;cursor:pointer}
.btn.sm{padding:.4rem .9rem;font-size:.75rem;border-radius:10px}
.btn.ok{background:#2e7d32}.btn.no{background:#b71c1c}.btn.map{background:#c9973b;color:#3a1710}
header{position:sticky;top:0;background:#3a1710;color:#e6c37c;padding:.8rem 1rem;display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap;font-weight:900;z-index:40}
header a{color:#e6c37c;font-size:.75rem;text-decoration:none}
.conn{background:#ffffff22;border-radius:50px;padding:.1rem .7rem;font-size:.65rem;color:#ffcdd2}
.conn.on{background:#2e7d3244;color:#a5d6a7}
#stats{display:flex;gap:.5rem;flex-wrap:wrap;padding:.8rem;max-width:1000px;margin:auto}
.st{flex:1;min-width:70px;background:#fff;border:1px solid #e8dcc9;border-radius:12px;padding:.4rem;text-align:center;font-size:.7rem;font-weight:800;color:#8a6f63}
.st b{display:block;font-size:1.1rem;color:#4d231b}
#list{max-width:1000px;margin:auto;padding:0 .8rem 4rem;display:flex;flex-direction:column;gap:.7rem}
.oc{background:#fff;border:1.5px solid #e8dcc9;border-radius:16px;padding:.8rem;display:flex;flex-direction:column;gap:.5rem}
.oh{display:flex;justify-content:space-between;align-items:center;font-weight:900;color:#4d231b}
.sc{border-radius:50px;padding:.12rem .7rem;font-size:.68rem;font-weight:900;color:#fff;flex-shrink:0}
.ob{font-size:.8rem;font-weight:700;color:#8a6f63;line-height:1.9}
.oa{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center}
.empty{text-align:center;color:#8a6f63;font-weight:800;padding:2rem;line-height:2}
#trackOv{position:fixed;inset:0;background:rgba(26,10,6,.75);display:flex;align-items:center;justify-content:center;z-index:100;padding:1rem}
.tc{background:#f7f1e6;border:2px solid #c9973b;border-radius:20px;max-width:420px;width:100%;padding:1.2rem;max-height:90vh;overflow-y:auto;text-align:center}
.tc h2{color:#4d231b;font-size:1.1rem}
.tl{display:flex;flex-direction:column;gap:.4rem;margin:.8rem 0;text-align:right}
.tli{font-size:.82rem;font-weight:800;color:#8a6f63;opacity:.45}
.tli.done,.tli.now{opacity:1;color:#4d231b}
.tli.now{background:#c9973b22;border:1px solid #c9973b;border-radius:10px;padding:.2rem .5rem}
#trR{color:#b71c1c;font-weight:800;font-size:.85rem}
#cmap{height:220px;border-radius:12px;margin-top:.6rem;display:none}
.drv{background:none!important;border:none!important;font-size:26px}
#toast{position:fixed;bottom:2rem;inset-inline:0;display:flex;justify-content:center;z-index:120;pointer-events:none}
#toast span{background:#3a1710;color:#fff;border-radius:50px;padding:.5rem 1.3rem;font-weight:800;font-size:.85rem;opacity:0;transition:.3s}
#toast span.show{opacity:1}
</style>
</head>
<body>

<div class="gate" id="gate"><div class="gc">
<img src="logo.png" alt="">
<h2>🖥️ لوحة المدير</h2><p>خاصة بإدارة ركن البشوات فقط</p>
<input type="password" id="adminPass" placeholder="كلمة السر">
<button class="btn" onclick="adminLogin()">🔓 دخول</button>
</div></div>

<div id="dash" hidden>
<header>
<div>🖥️ لوحة المدير <span class="conn" id="conn">🔴 اتصال…</span></div>
<div><a href="index.html">🥙 المنيو</a> <button class="btn sm no" id="logout">🚪 خروج</button></div>
</header>
<div id="stats"></div>
<div id="list"></div>
</div>

<div id="trackOv" style="display:none"><div class="tc">
<h2 id="trT">تتبع</h2><div class="tl" id="tl"></div><div id="trR"></div><div id="cmap"></div>
<br><button class="btn" onclick="closeTrack()">إغلاق ✕</button>
</div></div>

<div id="toast"><span id="toastMsg"></span></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const CH='bashawat-x9f3k7q2',CRYPT_PASS='bashawat-secure-2026',ADMIN_PASS='1234';
const $=s=>document.getElementById(s);
let _k;async function key(){if(_k)return _k;const kb=await crypto.subtle.importKey('raw',new TextEncoder().encode(CRYPT_PASS),'PBKDF2',false,['deriveKey']);_k=await crypto.subtle.deriveKey({name:'PBKDF2',salt:new TextEncoder().encode(CH),iterations:50000,hash:'SHA-256'},kb,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);return _k}
async function enc(o){const k=await key(),iv=crypto.getRandomValues(new Uint8Array(12));const ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv},k,new TextEncoder().encode(JSON.stringify(o))));const b=new Uint8Array(12+ct.length);b.set(iv);b.set(ct,12);return btoa(String.fromCharCode(...b))}
async function dec(s){try{const k=await key(),bin=Uint8Array.from(atob(s),c=>c.charCodeAt(0));return JSON.parse(new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv:bin.slice(0,12)},k,bin.slice(12))))}catch(e){return null}}
async function send(e){e.ts=Date.now();await fetch('https://ntfy.sh/'+CH,{method:'POST',body:await enc(e)})}
const S=new Map();
const ST={pending:['⏳ جديد','#c9973b'],approved:['✅ مؤكد','#2e7d32'],preparing:['👨 تحضير','#e65100'],ready:['📦 جاهز','#1565c0'],delivering:['🛵 توصيل','#6a1b9a'],delivered:['🎉 سُلّم','#33691e'],rejected:['❌ اعتذار','#b71c1c']};
(function(){const es=new EventSource('https://ntfy.sh/'+CH+'/sse?since=12h');
es.onopen=()=>{const c=$('conn');c.textContent='🟢 متصل';c.classList.add('on')};
es.onerror=()=>{const c=$('conn');c.textContent='🔴 اتصال…';c.classList.remove('on')};
es.onmessage=async m=>{const e=await dec(m.data.message);if(!e)return;
if(e.t==='order'&&!S.has(e.o.id)){S.set(e.o.id,{o:e.o,status:'pending',loc:null,ts:e.ts});beep();toast('🆕 طلب جديد #'+e.o.id)}
else if(e.t==='status'){const r=S.get(e.id);if(r){r.status=e.s;r.reason=e.reason||''}}
else if(e.t==='loc'){const r=S.get(e.id);if(r){r.loc=[e.lat,e.lng];moveMk()}}
render();updateTrack();}})();
function render(){const l=[...S.values()].sort((a,b)=>(b.ts||0)-(a.ts||0));
const c=s=>l.filter(r=>r.status===s).length;
const rev=l.filter(r=>r.status==='delivered').reduce((s,r)=>s+r.o.total,0);
$('stats').innerHTML=`<div class="st">جديدة<b>${c('pending')}</b></div><div class="st">تحضير<b>${c('approved')+c('preparing')}</b></div><div class="st">جاهزة<b>${c('ready')}</b></div><div class="st">توصيل<b>${c('delivering')}</b></div><div class="st">مبيعات<b>${rev} ريال</b></div>`;
$('list').innerHTML=l.length?l.map(r=>{const[lb,cl]=ST[r.status];let a='';
if(r.status==='pending')a=`<button class="btn sm ok" data-a="approved" data-id="${r.o.id}">✅ موافقة</button><button class="btn sm no" data-a="reject" data-id="${r.o.id}">❌ رفض</button>`;
else if(r.status==='approved')a=`<button class="btn sm" data-a="preparing" data-id="${r.o.id}">👨 بدء التحضير</button>`;
else if(r.status==='preparing')a=`<button class="btn sm" data-a="ready" data-id="${r.o.id}">📦 الطلب جاهز</button>`;
else if(r.status==='ready')a=`<span class="sc" style="background:#1565c0">⏳ بانتظار سائق</span>`;
else if(r.status==='delivering')a=`<button class="btn sm map" data-a="map" data-id="${r.o.id}">🗺️ تتبع</button><button class="btn sm ok" data-a="delivered" data-id="${r.o.id}">🎉 تسليم</button>`;
return `<div class="oc"><div class="oh">#${r.o.id} • ${r.o.total} ريال <span class="sc" style="background:${cl}">${lb}</span></div><div class="ob">👤 ${r.o.name} ${r.o.phone?'📞 '+r.o.phone:''}<br>📍 ${r.o.addr||'—'}${r.o.notes?'<br>📝 '+r.o.notes:''}<br>🧾 ${r.o.items.map(x=>x.q+'× '+x.n).join('، ')}</div><div class="oa">${a}</div></div>`}).join('')
:`<div class="empty">لا طلبات بعد..<br>أبقِ الصفحة مفتوحة 🔔</div>`}
$('list').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
const id=b.dataset.id,a=b.dataset.a;
if(a==='reject'){const r=prompt('سبب الرفض:','غير متوفر حالياً')||'';send({t:'status',id,s:'rejected',reason:r})}
else if(a==='map')openTrack(id);
else if(a)send({t:'status',id,s:a})});
let trackId=null,mo=null,mk=null;
const TL=['pending','approved','preparing','ready','delivering','delivered'];
const LB={pending:'⏳ بانتظار الموافقة',approved:'✅ تم التأكيد',preparing:'👨 جاري التحضير',ready:'📦 جاهز',delivering:'🛵 في الطريق',delivered:'🎉 تم التسليم'};
function openTrack(id){trackId=id;$('trackOv').style.display='flex';updateTrack()}
function closeTrack(){$('trackOv').style.display='none';trackId=null;if(mo){mo.remove();mo=null;mk=null}const m=$('cmap');m.style.display='none'}
function updateTrack(){if($('trackOv').style.display==='none'||!trackId)return;const r=S.get(trackId);if(!r)return;
$('trT').textContent='طلب #'+r.o.id+' — '+r.o.total+' ريال';
if(r.status==='rejected'){$('trR').textContent='❌ مرفوض'+(r.reason?': '+r.reason:'');$('tl').innerHTML='';return}
$('trR').textContent='';const i=TL.indexOf(r.status);
$('tl').innerHTML=TL.map((s,x)=>`<div class="tli ${x<i?'done':x===i?'now':''}">${x<=i?'✓':'•'} ${LB[s]}</div>`).join('');
if(r.status==='delivering'&&r.loc){$('cmap').style.display='block';
if(!mo){mo=L.map('cmap',{zoomControl:false}).setView(r.loc,15);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mo);if(r.o.lat!=null)L.marker([r.o.lat,r.o.lng]).addTo(mo).bindPopup('العميل 🏠')}
if(!mk)mk=L.marker(r.loc,{icon:L.divIcon({className:'drv',html:'🛵',iconSize:[28,28]})}).addTo(mo);else mk.setLatLng(r.loc);mo.panTo(r.loc)}}
function moveMk(){updateTrack()}
function beep(){try{const c=new(window.AudioContext||window.webkitAudioContext)(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=880;g.gain.value=.25;o.start();setTimeout(()=>{o.stop();c.close()},350)}catch(e){}}
let tT;function toast(m){const s=$('toastMsg');s.textContent=m;s.classList.add('show');clearTimeout(tT);tT=setTimeout(()=>s.classList.remove('show'),1800)}
function adminLogin(){if($('adminPass').value===ADMIN_PASS){sessionStorage.setItem('rb_adm','1');show()}else toast('❌ كلمة سر خاطئة')}
function show(){$('gate').hidden=true;$('dash').hidden=false;render()}
$('logout').onclick=()=>{sessionStorage.removeItem('rb_adm');location.reload()};
$('adminPass').addEventListener('keydown',e=>{if(e.key==='Enter')adminLogin()});
if(sessionStorage.getItem('rb_adm')==='1')show();
</script>
</body>
</html>
