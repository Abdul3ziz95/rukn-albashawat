<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1c2e4a">
<title>ركن البشوات — صفحة السائق</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body data-page="driver">

<div class="gate" id="driverGate">
  <div class="w-card g-card">
    <img src="logo.png" alt="" class="g-logo">
    <h2>🛵 صفحة السائق</h2>
    <p class="g-sub">خاصة بسائقي التوصيل فقط</p>
    <input type="password" id="driverPass" placeholder="كود السائق">
    <button class="w-btn" onclick="driverLogin()">🔓 دخول</button>
  </div>
</div>

<div id="driverDash" hidden>
  <header class="dash-head drv-head">
    <div class="dh-title">🛵 طلبات التوصيل <span class="conn">🔴 اتصال…</span></div>
    <div class="dh-btns">
      <a class="w-btn small" href="index.html">🥙 المنيو</a>
      <button class="w-btn small danger" id="driverLogout">🚪 خروج</button>
    </div>
  </header>
  <div id="driverList"></div>
</div>

<div id="toast"><span id="toastMsg"></span></div>
<script src="app.js"></script>
</body>
</html>
